{
  "name": "Rememberoll",
  "short_name": "Rememberoll",
  "start_url": "./app.html",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "background_color": "#eef1f4",
  "theme_color": "#1d2433",
  "icons": [
    {
      "src": "assets/img/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "assets/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/img/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "description": "The event camera and invitation app: guests scan a code to shoot and RSVP, hosts get every photo and a live guest list.",
  "categories": [
    "photo",
    "lifestyle",
    "social"
  ],
  "orientation": "any",
  "display_override": [
    "standalone"
  ],
  "shortcuts": [
    {
      "name": "Scan a code",
      "short_name": "Scan",
      "url": "./app.html#scan",
      "icons": [
        {
          "src": "assets/img/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My events",
      "short_name": "My events",
      "url": "./app.html#mine",
      "icons": [
        {
          "src": "assets/img/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Host",
      "short_name": "Host",
      "url": "./app.html#host",
      "icons": [
        {
          "src": "assets/img/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
